/*
 * Copy to secrets.h and fill in. secrets.h is gitignored - the private key
 * must never be committed. Regenerate the certificate if it is ever exposed.
 */
#pragma once

#define WIFI_SSID       "your-network"
#define WIFI_PASSWORD   "your-password"

// aws iot describe-endpoint --endpoint-type iot:Data-ATS --region ca-central-1
#define AWS_IOT_ENDPOINT "xxxxxxxxxxxxxx-ats.iot.ca-central-1.amazonaws.com"

// From certs/AmazonRootCA1.pem
static const char AWS_CERT_CA[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
...paste AmazonRootCA1.pem here...
-----END CERTIFICATE-----
)EOF";

// From certs/device-certificate.pem.crt
static const char AWS_CERT_CRT[] PROGMEM = R"KEY(
-----BEGIN CERTIFICATE-----
...paste device-certificate.pem.crt here...
-----END CERTIFICATE-----
)KEY";

// From certs/device-private.pem.key  -- treat as a secret
static const char AWS_CERT_PRIVATE[] PROGMEM = R"KEY(
-----BEGIN RSA PRIVATE KEY-----
...paste device-private.pem.key here...
-----END RSA PRIVATE KEY-----
)KEY";
